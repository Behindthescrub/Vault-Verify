// Recruiter tool — Prisma schema
// Dev: SQLite (sandbox / local). Production: change provider to "postgresql"
// for Supabase (see DEPLOY.md, one-line change).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & sessions ────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  company      String?
  role         String   @default("user") // "user" | "superadmin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  sessions     Session[]
  checklists   Checklist[]
  calculations Calculation[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Per-user calculator settings ────────────────────────────────────
model UserSettings {
  userId               String  @id
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String?
  companyLogoUrl       String? // data URL or https URL shown in calculator header
  defaultOnboardingPct Float   @default(22)
  minW2               Float   @default(15)
  otEnabled           Boolean @default(false)
}

// ─── Platform settings (managed by superadmin) ──────────────────────
model PlatformSetting {
  id               String  @id @default("main")
  // Brevo transactional email
  brevoApiKey      String?
  brevoSenderEmail String  @default("myzipvault@gmail.com")
  brevoSenderName  String  @default("VaultVerify")
  emailTestMode    Boolean @default(true) // true = log only, no real sends
  // Shared GSA Per Diem API key — superadmin-only, recruiters cannot override
  gsaApiKey        String?
  updatedAt        DateTime @updatedAt
}

// ─── Skills data (MyZipVault model: Profession → Job Title → Specialty → Category → Skill)
// Managed by the superadmin; imported from the Skills Data xlsx template.
model SkillTemplate {
  id         String   @id @default(cuid())
  profession String
  jobTitle   String
  specialty  String
  name       String // "{jobTitle} - {specialty} Skill Checklist"
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  skills     Skill[]

  @@unique([profession, jobTitle, specialty])
  @@index([profession, jobTitle])
}

model Skill {
  id            String        @id @default(cuid())
  templateId    String
  template      SkillTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skillName     String
  category      String
  questionType  String        @default("rating_1_4") // rating_1_4 | yes_no | text
  sortOrder     Int           @default(0) // order within the category
  categorySort  Int           @default(0) // order of the category within the template (natural/xlsx order)
  hasNaOption   Boolean       @default(false)

  @@index([templateId, category, sortOrder])
}

// ─── Skills checklists (sent to candidates) ──────────────────────
model Checklist {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  templateId      String? // snapshot source (no FK: templates may be deleted later)
  templateLabel   String    @default("Skills Checklist") // "Profession | Job Title | Specialty" snapshot
  candidateName   String?
  candidateEmail  String?
  status          String    @default("draft") // draft | sent | submitted
  submittedVia   String? // "link" | "manual" — set on completion
  token           String    @unique @default(cuid())
  itemsJson       String // snapshot: [{category, skills:[{name, questionType, hasNaOption}]}]
  inviteSentAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  response        ChecklistResponse?
}

model ChecklistResponse {
  id          String   @id @default(cuid())
  checklistId String   @unique
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  ratingsJson String // {"<skill>": 1..4 | "na" | "yes" | "no" | "<text>"}
  // VaultVerify checklist extras:
  lastPerformedJson String? // {"<skill>": "3m" | "6m" | "6m+" | "na"} — last time candidate performed each rated skill
  additionalJson    String? // {"experienceYears": number|null, "answers": {"<questionId>": "yes"|"no"|"<text>"}}
  avgRating   Float? // mean of numeric ratings (N/A excluded)
  signedName  String? // candidate's typed signature on submit
  printedName String? // candidate's printed (legal) name on the attestation
  validUntil  DateTime? // completedAt + 30 days (VALIDITY_DAYS)
  completedAt DateTime @default(now())
}

// ─── Saved calculator runs ───────────────────────────────────────────
model Calculation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  inputJson  String // full set of calculator inputs
  resultJson String // snapshot of computed outputs
  createdAt  DateTime @default(now())
}

// ─── Email log (Brevo sends & test-mode entries) ─────────────────────
model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  purpose   String // invite | test
  status    String // sent | failed | test-mode
  error     String?
  createdAt DateTime @default(now())
}
